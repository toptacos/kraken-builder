0002567"],"variations":[{"variables":[],"id":"30000002616","key":"30000002616","featureEnabled":true}],"id":"30000002615","key":"30000002615","layerId":"30000002612","trafficAllocation":[{"entityId":"30000002616","endOfRange":10000}],"forcedVariations":{}},{"status":"Running","audienceConditions":[],"audienceIds":[],"variations":[{"variables":[],"id":"30000002614","key":"30000002614","featureEnabled":true}],"id":"30000002613","key":"30000002613","layerId":"30000002612","trafficAllocation":[{"entityId":"30000002614","endOfRange":10000}],"forcedVariations":{}}],"id":"30000002612"},{"experiments":[{"status":"Running","audienceConditions":[],"audienceIds":[],"variations":[{"variables":[{"id":"30000002621","value":"[\"MKR\", \"DAI\", \"FTM\", \"FET\", \"MATIC\", \"RNDR\", \"GAL\", \"ZBC\"]"},{"id":"30000002624","value":"{ \"message\": \"Gemini is aware of the Polygon Endgame migration. While we do not support the SKY token, we continue to support the ERC-20 version of MKR. Customers can still deposit, withdraw, and trade MKR.\" }"},{"id":"30000002625","value":"{ \"message\": \"Gemini is aware of the Polygon Endgame migration. While we do not support the USDS token, we continue to support the ERC-20 version of DAI. Customers can still deposit, withdraw, and trade DAI.\" }"},{"id":"30000002626","value":"{ \"message\": \"Gemini is aware of the FTM to S migration. While we do not support the new S token, we continue to support the ERC-20 version of FTM. Customers can still deposit, withdraw, and trade FTM.\" }"},{"id":"30000002627","value":"{ \"message\": \"Gemini is aware of the FET to ASI migration. While we do not support the new ASI token, we continue to support the ERC-20 version of FET. Customers can still deposit, withdraw, and trade FET.\" }"},{"id":"30000002628","value":"{\"message\": \"On August 19, 2025, Gemini completed the migration from MATIC to Polygon's POL token. All customer MATIC balances were automatically converted to POL at a 1:1 ratio.\"}"},{"id":"30000002629","value":"{ \"message\": \"Gemini is aware of the RNDR to RENDER migration. While we do not support the new RENDER token, we continue to support the ERC-20 version of RNDR. Customers can still deposit, withdraw, and trade RNDR. \\n\\nIf you prefer, you may withdraw your RNDR tokens to a self-hosted wallet to complete the migration manually. Any updates or changes to these features will be communicated through Gemini's official channels as soon as they are available.\" }"},{"id":"30000002630","value":"{ \"message\": \"Gemini does not intend to support the GAL to G migration. However, Gemini will continue to provide custody for the GAL token, ensuring that customers can still deposit, withdraw, and trade. \\n\\nIf desired, you may withdraw your GAL tokens to an external wallet before the migration and complete it manually. Any changes to these features will be communicated through Gemini's official channels as soon as possible.\" }"},{"id":"30000002631","value":"{ \"message\": \"Gemini does not intend to support the ZBC to ZBCN migration. However, Gemini will continue to provide custody for the ZBC token, ensuring that customers can still deposit, withdraw, and trade. \\n\\nIf desired, you may withdraw your ZBC tokens to an external wallet before the migration and complete it manually. Any changes to these features will be communicated through Gemini's official channels as soon as possible.\" }"}],"id":"30000002620","key":"30000002620","featureEnabled":true}],"id":"30000002619","key":"30000002619","layerId":"30000002618","trafficAllocation":[{"entityId":"30000002620","endOfRange":10000}],"forcedVariations":{}}],"id":"30000002618"},{"experiments":[{"status":"Running","audienceConditions":["or","17611390365"],"audienceIds":["17611390365"],"variations":[{"variables":[],"id":"30000002637","key":"30000002637","featureEnabled":true}],"id":"30000002636","key":"30000002636","layerId":"30000002633","trafficAllocation":[{"entityId":"30000002637","endOfRange":10000}],"fo