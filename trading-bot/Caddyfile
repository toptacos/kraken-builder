# FrankenPHP Caddyfile Configuration
# Ultra-fast PHP web server with automatic HTTPS

# Main domain - FrankenPHP configuration
localhost {
    # Enable compression
    encode gzip

    # Root directory
    root * /app/public

    # Handle all requests with PHP
    php

    # API routes
    handle /api/* {
        try_files {path} {path}/ /public/index.php
        header Access-Control-Allow-Origin *
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # Static files
    handle_path /static/* {
        uri strip_prefix /static
        try_files {path} {path}/
        header Cache-Control max-age=31536000
    }

    # Default handler for all other requests
    handle {
        try_files {path} {path}/ /public/index.php
    }

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Logging
    log {
        output file /app/storage/logs/access.log
        format json
    }
}

# Development with hot reload
localhost:3000 {
    root * /app/public
    php

    # File server for development
    file_server
}