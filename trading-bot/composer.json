{
    "name": "kraken/trading-bot",
    "description": "Advanced Cryptocurrency Trading Bot with FrankenPHP",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Kraken Trading Bot Team",
            "email": "team@krakenbot.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.5",
        "guzzlehttp/guzzle": "^7.5",
        "ccxt/ccxt": "^4.1",
        "monolog/monolog": "^3.3",
        "symfony/console": "^6.2",
        "symfony/process": "^6.2",
        "react/event-loop": "^1.4",
        "react/http": "^1.8",
        "ratchet/pawl": "^0.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1",
        "phpstan/phpstan": "^1.9",
        "squizlabs/php_codesniffer": "^3.7",
        "phpmd/phpmd": "^2.13"
    },
    "autoload": {
        "psr-4": {
            "Kraken\\TradingBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kraken\\TradingBot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyze": "phpstan analyse",
        "start": "php bin/console trading:start",
        "stop": "php bin/console trading:stop",
        "status": "php bin/console trading:status"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}